# ─── TalkEasy environment example ─────────────────────────────────────────────
# Copy to `.env` and fill in. See docs/SETUP.md for full details.

# Required
DATABASE_URL=postgresql://user:password@localhost:5432/talkeasy

# JWT (required in production; server refuses to boot without them)
JWT_SECRET=change-me-strong-jwt-secret
JWT_REFRESH_SECRET=change-me-strong-refresh-secret

# Session secret (optional). Read only by the Replit login integration
# (server/replit_integrations/auth/replitAuth.ts), which is not mounted by the
# default server (local JWT auth is used instead). Leave blank unless you enable
# it; the code falls back to a known development-only default.
SESSION_SECRET=

# Server
NODE_ENV=development
# Keep 3000 unless you overrode the mobile/backend default. server/index.ts
# defaults to 5000 when unset; ApiClient (Flutter) defaults to http://localhost:3000.
PORT=3000

# Support-chat AI (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=phi3:latest
AI_TIMEOUT=30000

# Email (password reset). EMAIL_PROVIDER=auto picks a provider from the keys
# below; explicit options: resend | sendgrid | mailgun | smtp | console | none
# Ensure APP_PUBLIC_URL is the public origin — reset links are built from it.
EMAIL_PROVIDER=auto
RESEND_API_KEY=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Email sender. EMAIL_FROM must be an address on a domain you control and have
# authorised (SPF/DKIM) with your provider — it is NOT the public contact
# address. Use a placeholder until your sending domain is verified.
EMAIL_FROM=no-reply@your-domain.example
EMAIL_FROM_NAME=TalkEasy
APP_PUBLIC_URL=http://localhost:3000

# Public support contact shown in the app (legal pages, Settings, footer) and
# used as the mailto: target. Kept separate from the SMTP sender above. If
# unset, the shipped default (talkeasysupport@gmail.com) is used.
SUPPORT_EMAIL=talkeasysupport@gmail.com

# Password reset
RESET_TOKEN_EXPIRY_HOURS=1

# Remote push (FCM, legacy HTTP key). Leave empty to disable push — the server
# then reports configured:false and never claims delivery.
FCM_SERVER_KEY=
PUSH_PROVIDER=fcm

# Web Push (PWA background reminders). Generate a key pair with
#   node scripts/generate-vapid-keys.mjs
# The public key is served to the browser; keep the private key server-only and
# never commit it. VAPID_SUBJECT must be a mailto: or https: contact URL.
# Leave unset to disable Web Push — the server then reports
# webPushConfigured:false and never claims delivery.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:talkeasysupport@gmail.com